#!/usr/bin/env bash
#
# Archive store for the Threads notification center. Mechanical on purpose:
# every decision about what a notification means (thread key, labels) is made
# in ThreadLogic.js and arrives already computed; this script only moves JSON
# on disk, atomically, under a lock.
#
# Archive:  $XDG_STATE_HOME/omarchy/thread-center/archive.json   (JSON array,
#           newest entry first)
# State:    $XDG_STATE_HOME/omarchy/thread-center/state.json     ({readMark, clearedAt})
#
# Commands:
#   load                          print the archive ([] when empty)
#   meta                          print state.json ({} when empty)
#   upsert <stdin: entry-json>    prepend one entry, drop the notification it
#                                 replaces (replacesId/id), prune retention
#   set-id <sender> <cookie> <id>  backfill the daemon-assigned id (cookies
#                                 are per-connection, so the caller name
#                                 disambiguates)
#   remove <key>                  permanently drop one entry
#   remove-thread <stdin: key>    permanently drop one conversation (the key
#                                 is summary-derived, so it never enters argv)
#   clear                         empty the archive
#   mark-read [timestamp-ms]      persist the read watermark
#   prune                         apply retention to the existing archive
#   count                         print the entry count
set -euo pipefail

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
dir=$state_home/omarchy/thread-center
archive=$dir/archive.json
meta=$dir/state.json
keep_days=${THREAD_KEEP_DAYS:-30}
max_entries=${THREAD_MAX_ENTRIES:-2000}

now_ms() { date +%s%3N; }

mkdir -p "$dir"

# The watcher and the panel can issue commands at the same moment; the lock
# keeps an upsert from racing a clear. The fd stays open for the script's
# lifetime, which is bounded and short.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$dir/.lock"
  flock 9
fi

# Heal a missing or torn archive so a single bad write can never wedge the
# pipeline permanently.
if ! jq -e 'type == "array"' "$archive" >/dev/null 2>&1; then
  printf '[]\n' > "$archive"
fi

load_archive() { jq -c '.' "$archive"; }

load_meta() {
  if jq -e 'type == "object"' "$meta" >/dev/null 2>&1; then jq -c '.' "$meta"; else echo '{}'; fi
}

# Reads a validated archive on stdin and swaps it into place. The temp file is
# in the same directory, so the rename is atomic on any sane filesystem.
write_archive() {
  local tmp
  tmp=$(mktemp "$dir/.archive.XXXXXX")
  if cat >"$tmp" && jq -e 'type == "array"' "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$archive"
  else
    rm -f "$tmp"
    echo "thread-store: refusing to write an invalid archive" >&2
    return 1
  fi
}

write_meta() {
  local tmp
  tmp=$(mktemp "$dir/.state.XXXXXX")
  if cat >"$tmp" && jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$meta"
  else
    rm -f "$tmp"
    echo "thread-store: refusing to write invalid state" >&2
    return 1
  fi
}

require_uint() {
  local name=$1 value=${2:-}
  case $value in
  '' | *[!0-9]*)
    echo "thread-store: $name must be a non-negative integer" >&2
    exit 2
    ;;
  esac
}

cmd=${1:-}
shift || true

case $cmd in
load)
  load_archive
  ;;
meta)
  load_meta
  ;;
upsert)
  # The entry arrives on stdin, never in argv: /proc/<pid>/cmdline is readable
  # by other local users, and a notification body is private. jq sees it on
  # stdin too, so it never lands in jq's arguments either.
  entry=$(jq -cs '.[0]' 2>/dev/null) || entry=
  if [[ -z $entry || $entry == null ]]; then
    echo "thread-store: upsert needs a JSON entry on stdin" >&2
    exit 2
  fi
  { printf '%s\n' "$entry"; load_archive; } |
    jq -cs --argjson now "$(now_ms)" \
      --argjson keepDays "$keep_days" --argjson maxEntries "$max_entries" '
      .[0] as $e
      | ($e + {key: ($e.key //
        ((($e.timestamp // 0) | tostring) + "-" + ((($e.cookie // $e.id // 0) | tostring))))}) as $entry
      | ([$entry] + [
          .[1][] | select(
            (
              ((($entry.replacesId // 0) > 0) and ((.id // 0) == ($entry.replacesId // 0)))
              or
              ((($entry.id // 0) > 0) and ((.id // 0) == ($entry.id // 0)) and ((.key // "") != ($entry.key // "")))
              # Same key = the same bus message seen again (e.g. two watchers
              # during a shell rescan); replace, never stack a duplicate.
              or ((.key // "") == ($entry.key // ""))
            ) | not
          )
        ])
      | map(select((.timestamp // 0) >= ($now - $keepDays * 86400000)))
      | .[0:$maxEntries]
    ' | write_archive
  ;;
set-id)
  sender=${1:-}
  cookie=${2:-}
  id=${3:-}
  [[ -n $sender ]] || { echo "thread-store: set-id needs a sender, cookie and id" >&2; exit 2; }
  require_uint cookie "$cookie"
  require_uint id "$id"
  load_archive |
    jq -c --arg sender "$sender" --argjson cookie "$cookie" --argjson id "$id" '
      map(if (.sender // "") == $sender and (.cookie // -1) == $cookie then .id = $id else . end)
    ' | write_archive
  ;;
remove)
  key=${1:-}
  [[ -n $key ]] || { echo "thread-store: remove needs an entry key" >&2; exit 2; }
  load_archive |
    jq -c --arg key "$key" 'map(select((.key // "") != $key))' | write_archive
  ;;
remove-thread)
  # The key is summary-derived (conversation names), so it arrives on stdin
  # and reaches jq through a private fd, never through argv.
  [[ $# -eq 0 ]] || { echo "thread-store: remove-thread takes the thread key on stdin" >&2; exit 2; }
  thread_key=$(cat)
  thread_key=${thread_key%$'\n'}
  [[ -n $thread_key ]] || { echo "thread-store: remove-thread needs a thread key on stdin" >&2; exit 2; }
  load_archive |
    jq -c --slurpfile tk <(printf '%s' "$thread_key" | jq -Rs .) \
      'map(select((.threadKey // "") != $tk[0]))' | write_archive
  ;;
clear)
  echo '[]' | write_archive
  jq -cn --argjson now "$(now_ms)" '{readMark: $now, clearedAt: $now}' | write_meta
  ;;
mark-read)
  ts=${1:-$(now_ms)}
  require_uint timestamp "$ts"
  jq -cn --argjson old "$(load_meta)" --argjson ts "$ts" \
    '$old + {readMark: $ts}' | write_meta
  ;;
prune)
  load_archive |
    jq -c --argjson now "$(now_ms)" --argjson keepDays "$keep_days" \
      --argjson maxEntries "$max_entries" '
      map(select((.timestamp // 0) >= ($now - $keepDays * 86400000)))
      | .[0:$maxEntries]
    ' | write_archive
  ;;
count)
  load_archive | jq 'length'
  ;;
*)
  echo "Usage: thread-store {load|meta|upsert <stdin-json>|set-id <sender> <cookie> <id>|remove <key>|remove-thread <stdin-key>|clear|mark-read [ts]|prune|count}" >&2
  exit 2
  ;;
esac
